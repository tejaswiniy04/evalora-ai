# ─────────────────────────────────────────────
# Evalora AI — Environment Variables Template
# ─────────────────────────────────────────────
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your Groq key below
# 3. Get a FREE key at: https://console.groq.com
# ─────────────────────────────────────────────

GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM model (Groq free tier options):
#   llama-3.1-8b-instant       ← fast, default
#   llama-3.3-70b-versatile    ← better reasoning, slower
LLM_MODEL=llama-3.1-8b-instant

# Admin Email Notifications
ADMIN_EMAIL=ayushhmane@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
